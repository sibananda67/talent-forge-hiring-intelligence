# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APIFY_API_TOKEN: Required for fetching Apify search scraper runs and datasets.
# Can also be entered in Settings -> Integrations within the dashboard.
APIFY_API_TOKEN=""

# HUNTER_API_KEY: Required for finding decision makers and verifying professional emails.
# Can also be entered in Settings -> Integrations within the dashboard.
HUNTER_API_KEY=""

# SALESHANDY_API_KEY: Required for email sequence delivery via Saleshandy.
# Get this from your Saleshandy account under Settings -> API.
# Can also be entered in Settings -> Integrations within the dashboard.
SALESHANDY_API_KEY=""

# SALESHANDY_API_BASE_URL: Base URL for Saleshandy API (defaults to https://open-api.saleshandy.com/v1)
SALESHANDY_API_BASE_URL="https://open-api.saleshandy.com/v1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

